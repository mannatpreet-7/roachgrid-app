  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "^3.9.10",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  }

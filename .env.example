# Public endpoints ONLY. Vite variables are shipped to the browser; never add secrets.
# For deployment use a policy-compliant shared proxy or your own providers.
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
VITE_ROUTER_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving

# Optional second Overpass provider (same response schema, CORS required).
VITE_OVERPASS_FALLBACK_URL=https://overpass.private.coffee/api/interpreter
# Optional public event JSON feed URL. Omit to use bundled data/events.json.
# Expected {"checkedOn":"YYYY-MM-DD","items":[{"id":"unique","title":"Real event","startsOn":"YYYY-MM-DD","endsOn":"YYYY-MM-DD","lat":30.74,"lon":76.79,"venue":"Organizer confirmed venue","city":"City","source":"https://organizer.example/event","sourceLabel":"Organizer","description":"Confirm current details","organizerUrl":"https://organizer.example/event"}]}
# VITE_EVENTS_URL=https://your-public-host/events.json
